generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  phone                 String   @unique
  name                  String?
  pseudo                String?
  email                 String?
  gender                String?                         // male, female, other
  city                  String?
  country               String   @default("US")
  role                  String   @default("client") // client, agent
  agentCode             String?  @unique              // AGT-XXXXXX format (old)
  agentNumber           String?  @unique              // AGT-2026-XXXXX format (official)
  validationStatus      String   @default("validated") // pending, validated, rejected (agents only)
  validationRejectReason String?
  password              String?
  pin                   String?
  realBalance           Float    @default(0)
  realBalanceFC         Float    @default(0)
  bonusBalance          Float    @default(10)
  bonusBalanceFC        Float    @default(0)
  bonusBlocked          Boolean  @default(false)       // Block abusive bonus usage
  bonusBlockedReason    String?                       // Reason for blocking bonus
  isVerified            Boolean  @default(false)
  suspended             Boolean  @default(false)
  suspensionReason      String?
  tempBlocked           Boolean  @default(false)
  pinAttempts           Int      @default(0)
  hasCompletedOnboarding Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sentTransactions     Transaction[]     @relation("SenderTransactions")
  receivedTransactions Transaction[]     @relation("ReceiverTransactions")
  agentTransactions    Transaction[]     @relation("AgentTransactions")
  agentDeposits        Deposit[]         @relation("AgentDeposits")
  agentWithdrawals     Withdrawal[]      @relation("AgentWithdrawals")
  purchases            Purchase[]
  marketplaceProducts  MarketplaceProduct[]
  barterOffers         BarterOffer[]
  barterChats          BarterChatParticipant[]
  notifications        Notification[]
  deposits             Deposit[]
  withdrawals          Withdrawal[]
  ussdFavorites        UssdFavorite[]
  creditPurchases      CreditPurchase[]
  billPayments         BillPayment[]
  userSettings         UserSettings?
  bonusHistory         BonusHistory[]
  receivedAgentMessages AgentMessage[]   @relation("ReceivedAgentMessages")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, super_admin
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs   AdminActivityLog[]
  globalNotifications GlobalNotification[]
  bonusCampaigns  BonusCampaign[]
  sentAgentMessages AgentMessage[]
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // login, suspend_user, delete_user, create_agent, suspend_agent, delete_agent, publish_product, delete_product, block_transaction, send_notification, etc.
  target    String?  // ID of the affected entity
  details   String?  // JSON string with additional info
  ipAddress String?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model GlobalNotification {
  id        String   @id @default(cuid())
  adminId   String
  title     String
  message   String
  type      String   @default("general") // announcement, alert, maintenance, promo
  sentToAll Boolean  @default(true)
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // send, receive, deposit, withdrawal
  amount      Float
  fee         Float    @default(0)
  currency    String   @default("USD")
  status      String   @default("pending") // pending, completed, failed, blocked
  senderId    String
  receiverId  String
  description String?
  agentId     String?
  blockReason String?
  createdAt   DateTime @default(now())

  sender   User @relation("SenderTransactions", fields: [senderId], references: [id])
  receiver User @relation("ReceiverTransactions", fields: [receiverId], references: [id])
  agent    User? @relation("AgentTransactions", fields: [agentId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([agentId])
  @@index([status])
}

model Deposit {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  currency  String   @default("USD")
  method    String   @default("mobile_money")
  status    String   @default("pending")
  agentId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  agent User?  @relation("AgentDeposits", fields: [agentId], references: [id])
}

model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  fee       Float    @default(0)
  currency  String   @default("USD")
  method    String   @default("mobile_money")
  status    String   @default("pending")
  agentId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  agent User?  @relation("AgentWithdrawals", fields: [agentId], references: [id])
}

model MarketplaceProduct {
  id              String    @id @default(cuid())
  name            String
  description     String
  price           Float
  currency        String    @default("USD")        // USD, FC
  category        String
  imageUrl        String?
  sellerId        String?
  active          Boolean   @default(true)
  // Bonus fields
  bonusEnabled    Boolean   @default(false)        // Allow purchase with bonus
  bonusOnly       Boolean   @default(false)        // Exclusively purchasable with bonus
  bonusPrice      Float?                           // Specific bonus price (optional)
  bonusMaxQty     Int?                             // Max quantity purchasable with bonus per user
  bonusExpiryAt   DateTime?                        // Bonus availability expiry
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller    User?     @relation(fields: [sellerId], references: [id])
  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  productId   String
  buyerId     String
  amount      Float
  usedBonus   Float    @default(0)
  usedReal    Float    @default(0)
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id])
  buyer   User              @relation(fields: [buyerId], references: [id])
}

model BarterOffer {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  offeredBy   String
  wantedItem  String?
  images      String?
  status      String   @default("active") // active, matched, closed, moderated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [offeredBy], references: [id])
  chats BarterChat[]
}

model BarterChat {
  id          String   @id @default(cuid())
  offerId     String
  initiatedBy String
  createdAt   DateTime @default(now())

  offer        BarterOffer             @relation(fields: [offerId], references: [id])
  participants BarterChatParticipant[]
  messages     BarterMessage[]
}

model BarterChatParticipant {
  id     String   @id @default(cuid())
  chatId String
  userId String

  chat BarterChat @relation(fields: [chatId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model BarterMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  chat BarterChat @relation(fields: [chatId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── USSD System Models ─────────────────────────────────────────────

model UssdFavorite {
  id        String   @id @default(cuid())
  userId    String
  label     String
  phone     String
  type      String   @default("transfer") // transfer, credit
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  ussdLanguage           String   @default("fr") // fr, en, ln, sw, tl, kg
  defaultCurrency        String   @default("USD") // USD, FC
  smsNotifications       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditPurchase {
  id          String   @id @default(cuid())
  userId      String
  network     String   // Vodacom, Airtel, Orange, Africell
  phoneNumber String
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([network])
}

model BillPayment {
  id          String   @id @default(cuid())
  userId      String
  billType    String   // electricity, water, internet, subscription, other
  reference   String
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([billType])
}

// ─── Bonus System Models ───────────────────────────────────────────

model BonusHistory {
  id          String   @id @default(cuid())
  userId      String
  type        String   // registration, admin_grant, admin_remove, campaign, purchase, adjustment, blocked_unblocked
  amount      Float    // Positive = added, Negative = removed
  currency    String   @default("USD") // USD, FC
  description String?
  adminId     String?  // If action was by admin
  campaignId  String?  // If from a campaign
  metadata    String?  // JSON string with extra info
  createdAt   DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id])
  campaign BonusCampaign?  @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model BonusCampaign {
  id              String    @id @default(cuid())
  name            String
  description     String?
  bonusAmount     Float                          // Amount to grant per user
  currency        String    @default("USD")      // USD, FC
  targetUsers     String    @default("all")      // all, new, specific
  targetUserIds   String?                          // JSON array of user IDs (when targetUsers = "specific")
  status          String    @default("active")    // active, paused, completed, expired
  maxDistributions Int?                           // Max total distributions
  currentCount    Int       @default(0)           // Current distributions
  startDate       DateTime  @default(now())
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  history         BonusHistory[]
  adminId         String
  admin           Admin     @relation(fields: [adminId], references: [id])

  @@index([status])
  @@index([startDate])
}

// ─── Agent Messaging System ──────────────────────────────────────

model AgentMessage {
  id          String   @id @default(cuid())
  adminId     String
  recipientId String                         // User ID of the agent
  title       String
  message     String
  type        String   @default("individual") // individual, broadcast
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  admin    Admin @relation(fields: [adminId], references: [id])
  recipient User  @relation("ReceivedAgentMessages", fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([adminId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── App Version ─────────────────────────────────────────────────

model AppVersion {
  id          String   @id @default(cuid())
  version     String   @unique               // e.g. "1.0.0"
  description String?
  downloadUrl String?
  isCurrent   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── Developer Portal Models ─────────────────────────────────────

model Developer {
  id              String   @id @default(cuid())
  fullName        String
  company         String?
  email           String   @unique
  phone           String
  country         String
  appName         String
  projectType     String                           // mobile_android, mobile_ios, web, flutter, react_native, python, php, javascript
  description     String?
  siteUrl         String?
  estimatedUsers  Int?
  status          String   @default("pending")     // pending, approved, rejected, suspended
  rejectReason    String?
  commissionRate  Float    @default(0.015)          // 1.5%
  totalTransactions Int     @default(0)
  totalVolume     Float    @default(0)
  totalCommission Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apiKeys         DeveloperApiKey[]
  commissions     ApiCommission[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model DeveloperApiKey {
  id          String   @id @default(cuid())
  developerId String
  publicKey   String   @unique                     // pk_live_XXXXX
  secretKey   String                           // sk_live_XXXXX (hashed)
  webhookUrl  String?
  mode        String   @default("test")          // test, live
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([publicKey])
}

model ApiCommission {
  id              String   @id @default(cuid())
  developerId     String
  transactionId   String?
  amount          Float
  commission      Float                            // 1.5% of amount
  currency        String   @default("USD")
  status          String   @default("collected")    // collected, pending, reversed
  createdAt       DateTime @default(now())

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([createdAt])
}

// ─── International Transfer Models ────────────────────────────────

model InternationalTransfer {
  id                String   @id @default(cuid())
  userId            String
  type              String                           // wallet, mobile_money, bank, card, merchant, api, qr_code
  recipientName     String
  recipientPhone    String?
  recipientAccount  String?
  recipientBank     String?
  swiftBic          String?
  iban              String?
  country           String
  currency          String   @default("USD")
  amount            Float
  fee               Float    @default(0)
  commission        Float    @default(0)             // 1.5% commission
  exchangeRate      Float?
  amountReceived    Float?
  status            String   @default("pending")     // pending, processing, completed, failed
  otpVerified       Boolean  @default(false)
  description       String?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
