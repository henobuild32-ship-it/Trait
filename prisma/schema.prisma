generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  phone                 String   @unique
  name                  String?
  pseudo                String?
  country               String   @default("US")
  role                  String   @default("client") // client, agent
  agentCode             String?  @unique              // AGT-XXXXXX format
  password              String?
  pin                   String?
  realBalance           Float    @default(0)
  realBalanceFC         Float    @default(0)
  bonusBalance          Float    @default(10)
  bonusBalanceFC        Float    @default(0)
  isVerified            Boolean  @default(false)
  suspended             Boolean  @default(false)
  suspensionReason      String?
  tempBlocked           Boolean  @default(false)
  pinAttempts           Int      @default(0)
  hasCompletedOnboarding Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sentTransactions     Transaction[]     @relation("SenderTransactions")
  receivedTransactions Transaction[]     @relation("ReceiverTransactions")
  agentTransactions    Transaction[]     @relation("AgentTransactions")
  agentDeposits        Deposit[]         @relation("AgentDeposits")
  agentWithdrawals     Withdrawal[]      @relation("AgentWithdrawals")
  purchases            Purchase[]
  marketplaceProducts  MarketplaceProduct[]
  barterOffers         BarterOffer[]
  barterChats          BarterChatParticipant[]
  notifications        Notification[]
  deposits             Deposit[]
  withdrawals          Withdrawal[]
  ussdFavorites        UssdFavorite[]
  creditPurchases      CreditPurchase[]
  billPayments         BillPayment[]
  userSettings         UserSettings?
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, super_admin
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs   AdminActivityLog[]
  globalNotifications GlobalNotification[]
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // login, suspend_user, delete_user, create_agent, suspend_agent, delete_agent, publish_product, delete_product, block_transaction, send_notification, etc.
  target    String?  // ID of the affected entity
  details   String?  // JSON string with additional info
  ipAddress String?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model GlobalNotification {
  id        String   @id @default(cuid())
  adminId   String
  title     String
  message   String
  type      String   @default("general") // announcement, alert, maintenance, promo
  sentToAll Boolean  @default(true)
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // send, receive, deposit, withdrawal
  amount      Float
  fee         Float    @default(0)
  currency    String   @default("USD")
  status      String   @default("pending") // pending, completed, failed, blocked
  senderId    String
  receiverId  String
  description String?
  agentId     String?
  blockReason String?
  createdAt   DateTime @default(now())

  sender   User @relation("SenderTransactions", fields: [senderId], references: [id])
  receiver User @relation("ReceiverTransactions", fields: [receiverId], references: [id])
  agent    User? @relation("AgentTransactions", fields: [agentId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([agentId])
  @@index([status])
}

model Deposit {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  currency  String   @default("USD")
  method    String   @default("mobile_money")
  status    String   @default("pending")
  agentId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  agent User?  @relation("AgentDeposits", fields: [agentId], references: [id])
}

model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  fee       Float    @default(0)
  currency  String   @default("USD")
  method    String   @default("mobile_money")
  status    String   @default("pending")
  agentId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  agent User?  @relation("AgentWithdrawals", fields: [agentId], references: [id])
}

model MarketplaceProduct {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  imageUrl    String?
  sellerId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller    User?     @relation(fields: [sellerId], references: [id])
  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  productId   String
  buyerId     String
  amount      Float
  usedBonus   Float    @default(0)
  usedReal    Float    @default(0)
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id])
  buyer   User              @relation(fields: [buyerId], references: [id])
}

model BarterOffer {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  offeredBy   String
  wantedItem  String?
  images      String?
  status      String   @default("active") // active, matched, closed, moderated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [offeredBy], references: [id])
  chats BarterChat[]
}

model BarterChat {
  id          String   @id @default(cuid())
  offerId     String
  initiatedBy String
  createdAt   DateTime @default(now())

  offer        BarterOffer             @relation(fields: [offerId], references: [id])
  participants BarterChatParticipant[]
  messages     BarterMessage[]
}

model BarterChatParticipant {
  id     String   @id @default(cuid())
  chatId String
  userId String

  chat BarterChat @relation(fields: [chatId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model BarterMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  chat BarterChat @relation(fields: [chatId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── USSD System Models ─────────────────────────────────────────────

model UssdFavorite {
  id        String   @id @default(cuid())
  userId    String
  label     String
  phone     String
  type      String   @default("transfer") // transfer, credit
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  ussdLanguage           String   @default("fr") // fr, en, ln, sw, tl, kg
  defaultCurrency        String   @default("USD") // USD, FC
  smsNotifications       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditPurchase {
  id          String   @id @default(cuid())
  userId      String
  network     String   // Vodacom, Airtel, Orange, Africell
  phoneNumber String
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([network])
}

model BillPayment {
  id          String   @id @default(cuid())
  userId      String
  billType    String   // electricity, water, internet, subscription, other
  reference   String
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([billType])
}
